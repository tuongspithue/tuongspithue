# Sao chép thành .env khi chạy cục bộ. Không bao giờ commit file .env.
DATABASE_URL=postgres://sqt:sqt@localhost:5432/sqt
JWT_SECRET=doi-chuoi-bi-mat-nay
# Số điện thoại được cấp quyền ADMIN khi kích hoạt, cách nhau bởi dấu phẩy.
# Mã kích hoạt đầu tiên: pnpm --filter @sqt/api build && node apps/api/dist/src/database/activation-code.js 0900000001
ADMIN_PHONES=0900000001
PORT=3000
# Khoá mã hoá key AI do Admin nhập (bắt buộc ở production, chuỗi ngẫu nhiên dài).
AI_KEY_ENCRYPTION_KEY=doi-chuoi-ngau-nhien-dai
# Thông báo đẩy qua trình duyệt (miễn phí). Tạo bằng: pnpm --filter @sqt/api vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@shipquanhtoi.vn
# Các origin của web app được gọi API (Admin Console, app khách/quán/shipper bản web)
CORS_ORIGINS=http://localhost:3001
