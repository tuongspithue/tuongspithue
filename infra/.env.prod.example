# Sao chép thành infra/.env.prod và điền giá trị thật. KHÔNG commit file .env.prod.

# Tên miền (trỏ bản ghi A của cả 3 tên về IP máy chủ trước khi chạy).
# App quán & shipper là app cài đặt, gọi thẳng DOMAIN_API.
DOMAIN_APP=app.vidu.vn
DOMAIN_ADMIN=admin.vidu.vn
DOMAIN_API=api.vidu.vn
ACME_EMAIL=ban@vidu.vn

# Bí mật — tạo chuỗi ngẫu nhiên dài, VD: openssl rand -hex 32
DB_PASSWORD=
JWT_SECRET=
AI_KEY_ENCRYPTION_KEY=

# Số điện thoại được quyền Admin (cách nhau dấu phẩy)
ADMIN_PHONES=0900000001

# Giai đoạn thử nghiệm: cho phép giả lập "đã thanh toán online". Đặt false khi ký cổng thanh toán thật.
TEST_PHASE=true

# Thông báo đẩy (miễn phí). Tạo bằng: pnpm --filter @sqt/api vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ban@vidu.vn
